# Phase 2 — IMD ingestion configuration
# Copy this file to .env and fill in real values once available.
# Nothing in Phase 2 code currently requires an API key (IMD's documented
# endpoints do not use one) -- what's actually required is IP whitelisting,
# which is an infrastructure step (a static outbound IP registered with
# IMD), not a secret to store here. This file exists for forward-compatibility:
# MOSDAC (Phase 3+) does require registered-user credentials, and this is
# where they will go.

# IMD (Phase 2) -- no API key currently required; access is via IP whitelisting.
# Leave blank unless IMD issues one in the future.
IMD_API_KEY=

# MOSDAC (Phase 3+) -- requires registration; fill in once obtained.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Copernicus CDS (used by download_weather.py for Phase 1 ERA5 data)
# See: https://cds.climate.copernicus.eu/how-to-api
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
