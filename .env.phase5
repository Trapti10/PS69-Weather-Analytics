# Phase 5 Environment Configuration

# Database
DATABASE_URL=postgresql://ps69_admin:ps69_dev_password@localhost:5432/ps69_weather
SQLALCHEMY_ECHO=false

# JWT / Auth
JWT_SECRET=phase5_dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# FastAPI
FASTAPI_ENV=development
FASTAPI_DEBUG=true

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Feature flags
ENABLE_SOCIAL_FIXTURE_INGESTION=true
ENABLE_ALERT_DELIVERY=false
ALERT_CONSOLE_LOG=true
